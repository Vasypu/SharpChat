@page "/"
@using Common
@using Messenger.BlazorClient.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Messenger.BlazorClient.Services
@using Messenger.BlazorClient.Models.StorageModels
@inject NavigationManager Navigation
@inject IStorageService Storage
@inject P2PChatService P2PChatService
@implements IAsyncDisposable

<div class="messenger-app">
    
    @if (!isLoggedIn)
    {
        <div class="login-screen">
            <div class="login-box">
                <h2>Вход в SharpChat 💬</h2>
                @if (!string.IsNullOrEmpty(loginErrorMessage))
                {
                    <div class="alert alert-danger" style="font-size: 0.9em; border-radius: 8px; margin-bottom: 15px;">
                        ⚠️ @loginErrorMessage
                    </div>
                }
                <input @bind="currentUserName" placeholder="Введите ваш никнейм..." class="form-control mb-3" disabled="@isConnecting" />
                <button @onclick="ConnectToChat" disabled="@(string.IsNullOrWhiteSpace(currentUserName) || isConnecting)" class="btn btn-primary w-100">
                    @if (isConnecting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Подключение...</span>
                    }
                    else
                    {
                        <span>Войти PSP</span>
                    }
                </button>

                <button @onclick="ConnectToP2PChat" disabled="@(string.IsNullOrWhiteSpace(currentUserName) || isConnecting)" class="btn btn-primary w-100">
                    @if (isConnecting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Подключение...</span>
                    }
                    else
                    {
                        <span>Войти P2P</span>
                    }
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="messenger-container">

            <div class="sidebar">
                <div class="sidebar-header">
                    <h4>@currentUserName (Вы)</h4>
                    <small class="text-muted">Статус: @ConnectionStatusText</small>
                </div>
                <div class="contacts-list">
                    @foreach (var contact in contacts)
                    {
                        <div class="contact-item @(selectedContact == contact ? "active" : "")" 
                             @onclick="() => SelectContact(contact)">
                            <div class="contact-avatar">@(string.IsNullOrEmpty(contact.Name) ? "?" : contact.Name[0].ToString().ToUpper())</div>
                            <div class="contact-info">
                                <div class="contact-name">@contact.Name</div>
                                <div class="contact-last-msg">
                                    @(contact.Messages.LastOrDefault()?.Content ?? "Нет сообщений")
                                </div>
                            </div>
                        </div>
                    }
                    @if (!contacts.Any())
                    {
                        <div class="p-3 text-muted text-center" style="font-size: 0.9em;">
                            Пока никто не подключен. Откройте вкладку в другом браузере и введите другой ник!
                        </div>
                    }
                </div>
            </div>

            <div class="chat-area">
                @if (selectedContact != null)
                {
                    <div class="chat-header" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <h4>💬 @selectedContact.Name</h4>
                        <span class="connection-status-badge @ConnectionStatusClass">
                            ● @ConnectionStatusText
                        </span>
                    </div>

                    <div class="chat-history">
                        @foreach (var msg in selectedContact.Messages)
                        {
                            <div class="message-wrapper @(msg.IsOwnMessage ? "own-wrapper" : "their-wrapper")">
                                <div class="message-bubble @(msg.IsOwnMessage ? "own" : "their")">
                                    <div class="message-text">@msg.Content</div>
                                    <div class="message-time">@msg.Timestamp</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="chat-input-panel">
                        <input @bind="messageText" @bind:event="oninput" @onkeyup="HandleKeyPress" 
                               placeholder="Написать сообщение..." class="form-control" 
                               disabled="@(hubConnection?.State != HubConnectionState.Connected)" />
                        <button @onclick="SendMessage" 
                                disabled="@(string.IsNullOrWhiteSpace(messageText) || hubConnection?.State != HubConnectionState.Connected)" 
                                class="btn-send">
                            ▶
                        </button>
                    </div>
                }
                else
                {
                    <div class="no-chat-selected">
                        <p>Выберите, кому хотите написать из списка слева 👈</p>
                    </div>
                }
            </div>

        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private string currentUserName = "";
    private string messageText = "";
    private bool isLoggedIn = false;
    private bool isConnecting = false;
    private string? loginErrorMessage;

    private List<Contact> contacts = new();
    private Contact? selectedContact;

    private string ConnectionStatusText => hubConnection?.State switch
    {
        HubConnectionState.Connected => "Подключено",
        HubConnectionState.Connecting => "Подключение...",
        HubConnectionState.Reconnecting => "Переподключение...",
        HubConnectionState.Disconnected => "Отключено",
        _ => "Нет подключения"
    };

    private string ConnectionStatusClass => hubConnection?.State switch
    {
        HubConnectionState.Connected => "status-connected",
        HubConnectionState.Connecting => "status-connecting",
        HubConnectionState.Reconnecting => "status-reconnecting",
        HubConnectionState.Disconnected => "status-disconnected",
        _ => "status-disconnected"
    };

    private async Task ConnectToChat()
    {
        loginErrorMessage = null;
        isConnecting = true;
        StateHasChanged();

        try
        {
            var uri = new Uri(Navigation.Uri);
            var hubUrl = $"{uri.Scheme}://{uri.Host}:7138/chathub?username={Uri.EscapeDataString(currentUserName)}";

            // Настройка SignalR с передачей username в Query String
            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            // Регистрация событий состояния подключения для обновления интерфейса
            hubConnection.Closed += async (exception) =>
            {
                await InvokeAsync(StateHasChanged);
            };
            hubConnection.Reconnecting += async (exception) =>
            {
                await InvokeAsync(StateHasChanged);
            };
            hubConnection.Reconnected += async (connectionId) =>
            {
                await InvokeAsync(StateHasChanged);
                await RetrySendUnsyncedMessagesAsync();
            };

            // Слушаем приватные сообщения от сервера
            hubConnection.On<ChatMessage>("ReceivePrivateMessage", async chatMessage =>
            {
                //bool isOwn = chatMessage.ToUserId.Equals(currentUserName, StringComparison.OrdinalIgnoreCase);

                // Определяем, к какому чату относится сообщение
                // Если отправили мы — ищем чат с получателем. Если нам — чат с отправителем.
                string targetChatName = chatMessage.IsOwnMessage ? selectedContact?.Name ?? string.Empty : chatMessage.ToUserId;

                if (string.IsNullOrWhiteSpace(targetChatName)) return;

                // Ищем контакт в списке, если его нет — создаем динамически
                var contact = contacts.FirstOrDefault(c => c.Name.Equals(targetChatName, StringComparison.OrdinalIgnoreCase));
                if (contact == null)
                {
                    contact = new Contact { Name = targetChatName };
                    contacts.Add(contact);
                }

                if (chatMessage.IsOwnMessage)
                {
                    // Проверяем, есть ли уже это сообщение в UI (чтобы не дублировать отправленное локально)
                    if (!contact.Messages.Any(m => m.IsOwnMessage && m.Content == chatMessage.Content))
                    {
                        contact.Messages.Add(new ChatMessage(chatMessage.ToUserId, chatMessage.Content, DateTime.Now.ToShortTimeString(), isOwnMessage: true, ChatStatus.Delivered));
                    }
                }
                else
                {
                    // Добавляем в UI
                    contact.Messages.Add(new ChatMessage(chatMessage.ToUserId, chatMessage.Content, DateTime.Now.ToShortTimeString(), isOwnMessage: false, ChatStatus.Delivered));

                    // Входящее сообщение от собеседника — сохраняем в IndexedDB
                    var dbMessage = new Message
                    {
                        Id = Guid.NewGuid().ToString(),
                        ChatId = targetChatName,
                        SenderId = chatMessage.ToUserId,
                        Text = chatMessage.Content,
                        TimestampUtc = DateTime.UtcNow,
                        IsSynced = true,
                        IsRead = selectedContact?.Name == targetChatName
                    };
                    await Storage.SaveMessageAsync(dbMessage);
                    Console.WriteLine($"[{currentUserName}] Входящее сообщение сохранено: ChatId={targetChatName}, MsgId={dbMessage.Id}");
                }

                // Создаем/обновляем чат в IndexedDB
                var dbChat = new Chat
                {
                    Id = targetChatName,
                    Name = targetChatName,
                    LastMessageText = chatMessage.Content,
                    LastMessageTimestamp = DateTime.UtcNow,
                    UnreadCount = (selectedContact?.Name == targetChatName) ? 0 : 1
                };
                await Storage.SaveChatAsync(dbChat);

                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
            isLoggedIn = true;

            // Загружаем существующую историю из IndexedDB
            var savedChats = await Storage.GetChatsAsync();
            contacts.Clear();
            foreach (var chat in savedChats)
            {
                var contact = new Contact { Name = chat.Name };
                var savedMessages = await Storage.GetMessagesForChatAsync(chat.Id, limit: 100);
                savedMessages.Reverse(); // Сообщения возвращаются от новых к старым, поэтому реверсируем для правильного порядка в чате

                foreach (var msg in savedMessages)
                {
                    bool isOwn = msg.SenderId.Equals(currentUserName, StringComparison.OrdinalIgnoreCase);
                    contact.Messages.Add(new ChatMessage(
                        toUserId: msg.SenderId,
                        content: msg.Text,
                        timestamp: msg.TimestampUtc.ToLocalTime().ToShortTimeString(),
                        isOwnMessage: isOwn,
                        ChatStatus.Delivered
                    ));
                }
                contacts.Add(contact);
            }

            // ХАК ДЛЯ ТЕСТА: Чтобы было кому написать, автоматически добавим базовые контакты,
            // если их нет в списке и мы зашли под определенными именами
            if (currentUserName.Equals("Алиса", StringComparison.OrdinalIgnoreCase))
            {
                if (!contacts.Any(c => c.Name.Equals("Боб", StringComparison.OrdinalIgnoreCase)))
                    contacts.Add(new Contact { Name = "Боб" });
            }
            else if (currentUserName.Equals("Бob", StringComparison.OrdinalIgnoreCase) || currentUserName.Equals("Боб", StringComparison.OrdinalIgnoreCase))
            {
                if (!contacts.Any(c => c.Name.Equals("Алиса", StringComparison.OrdinalIgnoreCase)))
                    contacts.Add(new Contact { Name = "Алиса" });
            }
        }
        catch (Exception ex)
        {
            loginErrorMessage = $"Не удалось подключиться к серверу: {ex.Message}";
            if (hubConnection is not null)
            {
                await hubConnection.DisposeAsync();
                hubConnection = null;
            }
        }
        finally
        {
            isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task ConnectToP2PChat()
    {
        loginErrorMessage = null;
        isConnecting = true;
        StateHasChanged();

        try
        {
            await P2PChatService.InitializeAsync(currentUserName);

            P2PChatService.Peers!.OnMessageReceived += message =>
            {
                // обработка
            };


            //var uri = new Uri(Navigation.Uri);
            //var hubUrl = $"{uri.Scheme}://{uri.Host}:7138/signalinghub?username={Uri.EscapeDataString(currentUserName)}";

            // Настройка SignalR с передачей username в Query String
            /*hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();*/

            /*hubConnection.On<SignalMessage>("ReceiveSignal", async signal =>
            {
                // Здесь вызываешь PeerConnectionManager.HandleSignal(signal)
                await PeerConnectionService.HandleSignalAsync(signal);
            });*/

            hubConnection.On<string>("UserOnline", userId =>
            {
                // Обновить UI — пользователь появился
            });

            hubConnection.On<string>("UserOffline", userId =>
            {
                // Обновить UI — пользователь ушёл
            });

            await hubConnection.StartAsync();
            isLoggedIn = true;
        }
        catch (Exception ex)
        {
            loginErrorMessage = $"Не удалось подключиться к серверу: {ex.Message}";
            if (hubConnection is not null)
            {
                await hubConnection.DisposeAsync();
                hubConnection = null;
            }
        }
        finally
        {
            isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (hubConnection is not null && 
            hubConnection.State == HubConnectionState.Connected && 
            selectedContact is not null && 
            !string.IsNullOrWhiteSpace(messageText))
        {
            var textToSend = messageText;
            messageText = string.Empty;

            // Сохраняем сообщение локально с IsSynced=false до отправки
            var dbMessage = new Message
            {
                Id = Guid.NewGuid().ToString(),
                ChatId = selectedContact.Name,
                SenderId = currentUserName,
                Text = textToSend,
                TimestampUtc = DateTime.UtcNow,
                IsSynced = false,
                IsRead = true
            };
            await Storage.SaveMessageAsync(dbMessage);

            // Обновляем превью чата
            var dbChat = new Chat
            {
                Id = selectedContact.Name,
                Name = selectedContact.Name,
                LastMessageText = textToSend,
                LastMessageTimestamp = DateTime.UtcNow,
                UnreadCount = 0
            };
            await Storage.SaveChatAsync(dbChat);

            try
            {
                await hubConnection.InvokeAsync("SendPrivateMessage", selectedContact.Name, textToSend);
                // Подтверждаем успешную отправку на сервер
                await Storage.UpdateMessageSyncStatusAsync(dbMessage.Id, true);
            }
            catch (Exception e)
            {
                Console.WriteLine($"Ошибка при отправке сообщения: {e}");
                // IsSynced остается false — сообщение будет доотправлено при реконнекте
            }
        }
    }

    private async Task RetrySendUnsyncedMessagesAsync()
    {
        try
        {
            var unsynced = await Storage.GetUnsyncedMessagesAsync();
            foreach (var msg in unsynced)
            {
                try
                {
                    await hubConnection!.InvokeAsync("SendPrivateMessage", msg.ChatId, msg.Text);
                    await Storage.UpdateMessageSyncStatusAsync(msg.Id, true);
                }
                catch (Exception e)
                {
                    Console.WriteLine($"Не удалось доотправить сообщение {msg.Id}: {e.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при доотправке сообщений: {ex.Message}");
        }
    }

    private async Task SelectContact(Contact contact)
    {
        selectedContact = contact;
        // Помечаем сообщения как прочитанные в локальной базе данных
        try
        {
            await Storage.MarkMessagesAsReadAsync(contact.Name);
            // Также обновим нечитанные в чате
            var dbChat = await Storage.GetChatByIdAsync(contact.Name);
            if (dbChat != null)
            {
                dbChat.UnreadCount = 0;
                await Storage.SaveChatAsync(dbChat);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при пометке сообщений прочитанными: {ex}");
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            try
            {
                if (hubConnection.State == HubConnectionState.Connected)
                {
                    await hubConnection.StopAsync();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при закрытии соединения: {ex.Message}");
            }
            finally
            {
                await hubConnection.DisposeAsync();
            }
        }
    }
}